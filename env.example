# ============================================
# Cotizador.PiwiSuite - Variables de Entorno
# ============================================
#
# Instrucciones:
# 1. Copia este archivo a .env.local para desarrollo local
# 2. Para Easypanel, configura estas variables en la sección de Environment Variables
#
# ============================================

# ============================================
# Cloudflare API Backend
# ============================================
# URL del backend API (Cloudflare Worker)
NEXT_PUBLIC_API_URL=http://localhost:8787

# Google OAuth (opcional, para login con Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# GitHub OAuth (opcional, para login con GitHub)
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# ============================================
# Notas:
# ============================================
# - En producción, NEXT_PUBLIC_API_URL debe apuntar a tu Worker de Cloudflare
#   Ejemplo: https://cotizador-api.tu-domain.workers.dev
# - Las variables NEXT_PUBLIC_ son públicas y visibles en el cliente
# - Oauth client IDs se configuran en Google Cloud Console y GitHub Settings